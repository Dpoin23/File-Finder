# Copy to .env if you want local overrides. The CLI loads .env from the
# working directory and does not override variables already set in the shell.
# Queries do not use the network unless --explain is combined with the
# remote settings below.

# Config and SQLite index. Default: ${XDG_CONFIG_HOME:-~/.config}/file-finder
FF_CONFIG_DIR=

# Local embedding model (fastembed). Weights are cached under the config
# directory the first time `ff index` runs. Later queries stay on disk.
FF_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Optional remote rerank. Both URL and model must be set, and the user must
# pass `ff query --explain`. Only the top 15 snippets are sent.
FF_EXPLAIN_BASE_URL=
FF_EXPLAIN_MODEL=
FF_EXPLAIN_API_KEY=
